    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: runserver",
      "type": "debugpy",
      "request": "launch",
      "module": "manage",
      "args": ["runserver", "--noreload"],
      "cwd": "${workspaceFolder}/aria_project",
      "django": true
    },
    {
      // starts the django container with debugpy (docker-compose.debug.yml) and attaches to it
      "name": "Django: Docker",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [
        { "localRoot": "${workspaceFolder}/aria_project", "remoteRoot": "/app" }
      ],
      "django": true,
      "preLaunchTask": "docker: start django debug",
      "postDebugTask": "docker: stop django debug"
    }
  ]
}
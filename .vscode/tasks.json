{
  "version": "2.0.0",
  "tasks": [
    {
      // used by the "Django: Docker" launch config; waits until runserver is up before attaching
      "label": "docker: start django debug",
      "type": "shell",
      "command": "docker compose -f docker-compose.yml -f docker-compose.debug.yml up --build django",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "docker-django",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": ".",
          "endsPattern": "Starting .*server at"
        }
      }
    },
    {
      "label": "docker: stop django debug",
      "type": "shell",
      "command": "docker compose -f docker-compose.yml -f docker-compose.debug.yml stop django",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}

# Copy this file to .env in the repo root and fill in real values

DB_NAME=aria
DB_USER=aria
DB_PASSWORD=pass

# Where Django finds the database when running locally (python manage.py runserver):
#   local postgresql:                  DB_HOST=localhost  DB_PORT=5432
#   postgresql from docker compose:    DB_HOST=localhost  DB_PORT=5433
# When Django itself runs in docker compose, these two are ignored and it uses the compose db.
DB_HOST=localhost
DB_PORT=5433

# Password given to accounts created by `python manage.py sample_data` (development only)
SAMPLE_ACCOUNT_PASSWORD=aaaa

# Default accounts created on startup by `python manage.py create_default_accounts`
# (development only). Only created if the username doesn't exist yet; changing these
# later won't update an existing account. Leave username/password blank to skip one.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-admin
DEFAULT_ADMIN_EMAIL=admin@example.test
DEFAULT_STAFF_USERNAME=staff
DEFAULT_STAFF_PASSWORD=change-me-staff
DEFAULT_STAFF_EMAIL=staff@example.test

# Host port the docker compose postgresql is published on (default 5433)
# DB_DOCKER_PORT=5433

    subgraph S["1 Source"]
        P2["🐘 aria_phase2<br/>Phase 2 simulation<br/>(seed 2026: products,<br/>customers, orders)"]:::src
        GEN["🐍 generate_dataset.py<br/>sentence banks per topic<br/>stdlib, seed 202603"]:::py
        RAW["📄 reviews_raw.csv<br/>2,440 rows"]:::file
        GT["🔒 ground_truth.csv<br/>topic labels<br/>(never loaded)"]:::file
        SEED["📄 02_product_seed.sql<br/>product_kind + specs JSON<br/>+ subclass rows"]:::file
    end

    subgraph C["2 Cleaning"]
        CLEAN["🐍 clean_reviews.py<br/>decode HTML entities<br/>normalise whitespace<br/>drop 10 empty, 40 duplicates<br/>flag 14 short, 39 over 254 tokens"]:::py
        CLEANCSV["📄 reviews_clean.csv<br/>2,390 rows<br/>+ data_quality_report.md"]:::file
    end

    subgraph E["3 Embedding (local CPU, no API)"]

        VEC["📄 review_embeddings.csv<br/>query_embeddings.csv"]:::file
    end

    subgraph L["4 Load into PostgreSQL 18 + pgvector 0.8"]
        COPY["psql \copy<br/>04_reviews.sql · 05_vectors.sql"]:::pg
        PR[("product_reviews<br/>FKs · verified-purchase trigger<br/>details JSONB · body_tsv")]:::pg
        RE[("review_embeddings<br/>vector(384)")]:::pg
        PROD[("products.specs JSONB<br/>CHECK products_specs_valid<br/>+ 4 subclass tables")]:::pg
        API["fn_add_product()<br/>new products later"]:::pg
    end

    subgraph I["5 Indexes"]
        HNSW["HNSW<br/>vector_cosine_ops<br/>m=16, ef_construction=64"]:::pg
        GIN["GIN jsonb_path_ops<br/>specs · details"]:::pg
        FTS["GIN tsvector<br/>body_tsv"]:::pg
    end

    subgraph Q["6 Queries"]
        Q1["C1 semantic top-5<br/>C2 vector + filters<br/>C3 hybrid FTS + vector (RRF)<br/>D1 vector + subclass + JSONB"]:::out

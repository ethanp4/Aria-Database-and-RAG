rules_version = '2';

// Aria reviews prototype: no direct client access.
// Only the server (firebase-admin with a service account) reads and writes; the Admin SDK
// bypasses these rules. A future public product page would get a narrow read rule such as
//   match /reviews/{id} { allow read: if resource.data.status == 'published'; }
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
